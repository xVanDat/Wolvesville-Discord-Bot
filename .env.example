# Discord Developer Portal > Application > Bot
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id

# Optional: register commands instantly in one test server.
# Leave empty to register global commands (global propagation can take up to 1 hour).
DISCORD_GUILD_ID=

# Wolvesville > Settings > Wolvesville public API
WOLVESVILLE_API_KEY=your_wolvesville_api_key

# Optional settings
# Bot interface language: en (default) or vi
lang=en
WOLVESVILLE_API_BASE_URL=https://api.wolvesville.com
WOLVESVILLE_API_TIMEOUT_MS=10000
